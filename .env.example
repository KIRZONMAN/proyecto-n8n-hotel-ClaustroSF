# =============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO — Proyecto asistente hotelero (n8n + Ollama)
# =============================================================================
# Copie este archivo como ".env" en su máquina local y ajuste los valores.
# NO escriba aquí tokens, contraseñas ni rutas personales con datos sensibles.
# El archivo ".env" está en .gitignore y no debe subirse a GitHub.
# =============================================================================

# --- Zona horaria (alineado con el uso en Colombia / America/Bogota) ---
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# --- n8n: cookies seguras ---
# En desarrollo local con HTTP a veces se usa "false". En entorno expuesto a
# Internet use HTTPS y "true". Revise la documentación oficial de n8n.
N8N_SECURE_COOKIE=false

# --- Ollama (referencia para el equipo; el compose usa el servicio en Docker) ---
# URL interna desde el contenedor de n8n hacia Ollama:
#   http://ollama:11434
# Endpoint usado en el workflow exportado:
#   http://ollama:11434/api/generate
# Modelo de referencia en este repositorio:
#   qwen2.5:7b
# Comprobación desde el equipo anfitrión (fuera de Docker, puerto publicado):
#   curl http://localhost:11434/api/tags

# --- Integraciones opcionales (rellene solo en ".env" local, no en este ejemplo) ---
# Token de bot de Telegram, si en el futuro conectan Telegram a n8n:
TELEGRAM_BOT_TOKEN=reemplazar_si_aplica

# URL pública de n8n si usan webhooks o túneles (ngrok, Cloudflare Tunnel, etc.):
# N8N_HOST=
# WEBHOOK_URL=

# Credenciales de servicios en la nube (solo rutas o nombres genéricos aquí):
# GOOGLE_APPLICATION_CREDENTIALS=ruta_local_ejemplo/servicio-cuenta.json
